{
  "engine": {
    "type": "redis",
    "redis": {
      "address": "redis://redis:6379/0"
    }
  },
  "client": {
    "token": {
      "hmac_secret_key": "dev-secret-change-me"
    }
  },
  "http_api": {
    "key": "dev-api-key"
  },
  "admin": {
