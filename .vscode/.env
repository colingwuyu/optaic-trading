MODE=embedded
API_HOST=127.0.0.1
API_PORT=8081
OPTAIC_DATA_DIR=./.tmp/optaic-dev-data
DATABASE_URL=sqlite+aiosqlite:///./.tmp/optaic-dev-data/db/optaic.sqlite
